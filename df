local function load()
    local PlaceId = game.PlaceId

    -- RIVALS
    local RivalsPlaceIds = {
        126884695634066,
        17625359962,
        11729688377
    }

    for _, id in ipairs(RivalsPlaceIds) do
        if PlaceId == id then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AnamolDev/d/refs/heads/main/d"))()
            return
        end
    end

    -- BLOX FRUITS
    local BloxFruitsPlaceIds = {
        2753915549,
        4442272183,
        7449423635
    }

    for _, id in ipairs(BloxFruitsPlaceIds) do
        if PlaceId == id then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AnamolDev/bloxfuritii/refs/heads/main/okidk"))()
            return
        end
    end

    -- MURDER MYSTERY 2
    local MM2PlaceIds = {
        142823291,
        335132309
    }

    for _, id in ipairs(MM2PlaceIds) do
        if PlaceId == id then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AnamolDev/mm2/refs/heads/main/main"))()
            return
        end
    end

    -- FLICK
    local FlickPlaceIds = {
        136801880565837,
    }

    for _, id in ipairs(FlickPlaceIds) do
        if PlaceId == id then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/AnamolDev/flick/refs/heads/main/Main"))()
            return
        end
    end

    warn("Unsupported game!")
end

load()
